{
  "name": "tablight",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "train:head": "node scripts/train-head.mjs",
    "prepare:assets": "node scripts/fetch-model.mjs && node scripts/copy-ort.mjs",
    "build": "node scripts/third-party-notices.mjs && vite build",
    "notices": "node scripts/third-party-notices.mjs",
    "site": "node scripts/third-party-notices.mjs && node scripts/build-site.mjs",
    "test": "vitest run tests/unit",
    "test:quality": "vitest run tests/quality --reporter=verbose",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview:ui": "vite --config vite.preview.config.ts",
    "preview:vectors": "node scripts/make-preview-vectors.mjs",
    "package": "node scripts/package.mjs",
    "postbuild": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "idb": "8.0.4",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/archiver": "8.0.0",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "archiver": "8.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fake-indexeddb": "6.2.8",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "undici": "7.30.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
